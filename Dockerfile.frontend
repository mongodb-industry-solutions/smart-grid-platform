FROM node:22-slim
WORKDIR /app

# crypt_shared: required for MongoDB Queryable Encryption automatic encryption
# (query analysis). Must match the container's platform, not the dev machine's.
ARG CRYPT_SHARED_VERSION=9.0.2
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
         amd64) CS_ARCH=x86_64 ;; \
         arm64) CS_ARCH=aarch64 ;; \
         *) echo "unsupported arch $ARCH" && exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/crypt_shared.tgz \
       "https://downloads.mongodb.com/linux/mongo_crypt_shared_v1-linux-${CS_ARCH}-enterprise-ubuntu2404-${CRYPT_SHARED_VERSION}.tgz" \
    && mkdir -p /opt/crypt_shared /tmp/cs \
    && tar xzf /tmp/crypt_shared.tgz -C /tmp/cs \
    && cp /tmp/cs/lib/mongo_crypt_v1.so /opt/crypt_shared/ \
    && rm -rf /tmp/crypt_shared.tgz /tmp/cs \
    && rm -rf /var/lib/apt/lists/*
ENV CRYPT_SHARED_PATH=/opt/crypt_shared/mongo_crypt_v1.so

COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build
EXPOSE 8080
CMD ["npm", "start"]