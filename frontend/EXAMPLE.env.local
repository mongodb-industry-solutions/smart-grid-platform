MONGODB_URI=<YOUR_MONGODB_ATLAS_CONNECTION_STRING>
DATABASE_NAME=<YOUR_DATABASE_NAME>

# AI assistant - Claude via the standard Anthropic API
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
# Optional: override the default model (claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5

# Vector Map visualization - direct Voyage AI embeddings
VOYAGE_API_KEY=<YOUR_VOYAGE_API_KEY>

# --- Everything below is OPTIONAL (sensible defaults are built in) ---

# Where the Start Demo pipeline runs. The generate/load/feeder scripts live in the
# backend service; the frontend calls it here. Only set this if the backend isn't
# on the default localhost:8000 (run it with `uv run uvicorn main:app --port 8000`).
# BACKEND_URL=http://localhost:8000

# Query & Start Demo safeguards (see DEMO_SECURITY.md)
# Per-operation MongoDB timeout in ms (aborts a slow/runaway query; app-wide)
# MONGODB_TIMEOUT_MS=20000
# Minimum minutes between regenerations (0 disables the cooldown; handy while developing)
# DEMO_REGEN_COOLDOWN_MINUTES=60
# Max ms a setup step may run before it's killed
# DEMO_STEP_TIMEOUT_MS=600000